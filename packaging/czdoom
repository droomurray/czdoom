#!/bin/sh
# Launcher entry for czdoom: picks a WAD, a writable save directory and a
# soundfont, then starts the game. Output goes to /tmp/czdoom.log.
#
#   CZDOOM_WAD=/path/to/file.wad   force a specific game
#   CZDOOM_ASPECT=4:3              keep 4:3 instead of filling the screen
#   CZDOOM_ARGS="-nomusic"         extra engine arguments

APPDIR=/usr/share/APPLaunch/apps/czdoom
HOME="${HOME:-/tmp}"
WADDIR="$HOME/doom"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/czdoom"
LOG=/tmp/czdoom.log

mkdir -p "$DATA" "$WADDIR" 2>/dev/null
cd "$DATA" 2>/dev/null || cd /tmp
: >"$LOG" 2>/dev/null || LOG=/dev/null

WAD="${CZDOOM_WAD:-}"
if [ -z "$WAD" ]; then
    # Your own WADs in ~/doom win over the Freedoom ones from apt.
    for dir in "$WADDIR" "$APPDIR/wads" /usr/share/games/doom /usr/share/doom; do
        for name in doom2.wad DOOM2.WAD plutonia.wad PLUTONIA.WAD tnt.wad TNT.WAD \
                    doom.wad DOOM.WAD doom1.wad DOOM1.WAD freedoom2.wad freedoom1.wad; do
            if [ -f "$dir/$name" ]; then
                WAD="$dir/$name"
                break 2
            fi
        done
    done
fi

if [ -z "$WAD" ]; then
    echo "czdoom: no WAD found. Copy doom1.wad to $WADDIR or run: sudo apt install freedoom" >>"$LOG"
    exit 1
fi

# Music is MIDI and needs a soundfont; without one the game still has sound effects.
if [ -z "${SDL_SOUNDFONTS:-}" ]; then
    for sf in /usr/share/sounds/sf2/TimGM6mb.sf2 /usr/share/sounds/sf2/default-GM.sf2 \
              /usr/share/sounds/sf3/default-GM.sf3 /usr/share/sounds/sf2/FluidR3_GM.sf2; do
        if [ -f "$sf" ]; then
            SDL_SOUNDFONTS="$sf"
            export SDL_SOUNDFONTS
            break
        fi
    done
fi

echo "czdoom: wad=$WAD data=$DATA soundfont=${SDL_SOUNDFONTS:-none}" >>"$LOG"
# shellcheck disable=SC2086
exec "$APPDIR/czdoom" -iwad "$WAD" ${CZDOOM_ARGS:-} "$@" >>"$LOG" 2>&1
